# Claude / AI overlay
ANTHROPIC_API_KEY=your_key_here
# Optional Portfolio Manager-only monthly ceiling. Leave blank until Sam chooses
# the policy; blank reports NOT_CONFIGURED and preserves current behavior.
ANTHROPIC_MONTHLY_MAX_USD=
# Production safety switch: when true, a missing monthly ceiling refuses calls.
ANTHROPIC_BUDGET_REQUIRED=false
# ANTHROPIC_MONTHLY_WARN_PCT=0.8
# Optional immutable rate-table pin. Blank selects by the UTC usage date.
# ANTHROPIC_PRICING_VERSION=anthropic-global-standard-2026-07-14
# Conservative pre-call reservation floors; these do not replace the ceiling.
# ANTHROPIC_GENERATOR_CALL_RESERVE_USD=0.03
# ANTHROPIC_EVALUATOR_CALL_RESERVE_USD=0.10
# ANTHROPIC_WEEKLY_REVIEW_CALL_RESERVE_USD=0.03
# Optional dollars kept unavailable to discovery calls so held-position reviews
# and evaluator calls can still run near the ceiling. Must be <= monthly max.
# ANTHROPIC_MONTHLY_PROTECTED_RESERVE_USD=0
# Atomic authorization leases recover after a crashed caller (default 1800s).
# ANTHROPIC_CALL_LEASE_SECONDS=1800
# Requests larger than this cannot receive a provable pre-call cost bound.
# ANTHROPIC_MAX_REQUEST_BYTES=1000000
# Existing per-research-run guardrail (separate from the monthly ceiling).
# RESEARCH_RUN_MAX_USD=3
# Emergency, per-agent discovery rollback switches. Leave false in normal
# operation. Setting one true moves only that agent back to its seed watchlist,
# keeps its attributed holdings in the scan, and records a degraded receipt.
AGENT_1_CATALOG_ROLLBACK=false
AGENT_2_CATALOG_ROLLBACK=false
AGENT_3_CATALOG_ROLLBACK=false
# Optional: model for the independent proposal evaluator (lib/evaluator.js).
# Defaults to claude-opus-4-8 — deliberately a stronger tier than the triage
# overlay, since it only runs on the handful of actionable proposals per day.
# EVALUATOR_MODEL=claude-opus-4-8

# News search
TAVILY_API_KEY=your_key_here

# Optional: Athena external advisory research (read-only agent API). Only when
# explicitly enabled and both credentials are set does the research scan attach
# its per-ticker dossier as fenced, untrusted evidence. Keep quarantined until
# its data quality and alert behavior are reviewed.
ATHENA_ENABLED=false
ATHENA_AGENT_URL=
ATHENA_SERVICE_TOKEN=

# Optional macro snapshot (10Y yield, Fed funds rate, CPI, unemployment) in the AI overlay
# prompt — skipped entirely if blank. Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Robinhood read-only sync (robinhood-sync.py) — TOTP-based 2FA required
ROBINHOOD_USERNAME=your_robinhood_email
ROBINHOOD_PASSWORD=your_robinhood_password
ROBINHOOD_TOTP_SECRET=your_totp_secret
# Required if this login has more than one brokerage account (e.g. individual + IRA +
# an Agentic cash account) — robin_stocks silently defaults to whichever account Robinhood
# flags is_default=true, which is very likely NOT the one this bot should be trading in.
# Find it via the Robinhood MCP's get_accounts, or Robinhood app > account switcher.
ROBINHOOD_ACCOUNT_NUMBER=your_account_number
# Defaults false; only set true if you intentionally want robin_stocks to persist a login session on disk.
ROBINHOOD_STORE_SESSION=false
# Python interpreter for robinhood-sync.py (defaults to ./venv/bin/python3 if unset).
ROBINHOOD_PYTHON=python3

# HMAC signing for investor contribution/withdrawal ledger rows.
INVESTOR_LEDGER_HMAC_SECRET=generate_a_long_random_secret
OPERATIONAL_LEDGER_HMAC_SECRET=generate_a_distinct_long_random_secret
# Comma-separated old operational signing keys during rotation only; remove
# after long-lived rows are migrated and retained immutable rows age out.
OPERATIONAL_LEDGER_LEGACY_HMAC_SECRETS=

# Approval-signature verification secret — MUST match the dashboard's
# AUDIT_HMAC_SECRET. Fills are refused unless the proposal carries a valid
# dashboard-signed approval (see lib/proposal-signature.js).
AUDIT_HMAC_SECRET=same_value_as_dashboard
# Dedicated deploy-attestation key. No fallback to ledger/audit secrets; use a
# separately generated random value with at least 32 characters on the Jetson.
SYSLOOP_DEPLOY_HMAC_SECRET=replace_with_random_64_hex_char_value
# Dedicated cross-runtime key for scheduled broker-read receipts. Configure the
# same value on the Jetson backend and the read-worker only; it is deliberately
# separate from ledger, approval, and deploy-marker keys.
MCP_RECEIPT_HMAC_SECRET=replace_with_random_64_hex_char_value

# HTTP server (server.js). The webhook secret is REQUIRED — all routes except
# /health return 401 without it. Must match the dashboard's PORTFOLIO_WEBHOOK_SECRET.
PORTFOLIO_SERVER_PORT=3200
PORTFOLIO_WEBHOOK_SECRET=generate_a_long_random_secret

# Telegram push alerts (price alerts, execution problems). Optional but strongly
# recommended once real money is connected.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Pitch Lab is paper-only and disabled until explicitly launched. Its canonical
# record is Postgres. Redis supplies the candidate/peer inputs and carries only
# namespaced run-completion, Telegram-dedupe, and website-report projections.
# This shared file is authoritative for both portfolio-manager and pitch-lab;
# after changing the gate, restart both PM2 apps so weekly phone ownership agrees.
PITCH_LAB_ENABLED=0
PITCH_LAB_MODEL=claude-sonnet-4-6
PITCH_LAB_MAX_PITCHES=15
PITCH_LAB_MAX_USD=1.00
PITCH_LAB_PEER_REQUESTS=0
# Routine Phase 0 passes stay off phones; use "all" only for the legacy feed.
PHASE0_TELEGRAM_MODE=action-only

# Weekly investor email updates (Friday 6:45 PM ET). Uses Resend's email API.
# Stays off unless explicitly enabled.
INVESTOR_UPDATE_ENABLED=false
RESEND_API_KEY=
INVESTOR_UPDATE_FROM="Portfolio Manager <updates@example.com>"
INVESTOR_UPDATE_REPLY_TO=
INVESTOR_UPDATE_BCC=
INVESTOR_UPDATE_DASHBOARD_URL=https://portfolio-dashboard-ivory-five.vercel.app/investors
INVESTOR_UPDATE_SUBJECT_PREFIX=

# Google Sheets (service account) — reuse Jordan/MLB pattern
GOOGLE_CREDENTIALS_PATH=./credentials.json
# Alternative: base64-encoded service account JSON
# GOOGLE_SERVICE_ACCOUNT=

# Upstash Redis (shared instance, pm: prefix for this project)
UPSTASH_REDIS_REST_URL=your_redis_url
UPSTASH_REDIS_REST_TOKEN=your_redis_token

# Used to share the generated Sheet with your account
SAM_EMAIL=your_email_here

# One shared spreadsheet for the whole portfolio (all three agents get their own
# tab inside it — the per-agent spreadsheet model was retired 2026-06). Create a
# blank Sheet, share it with the service account (Editor), set the ID here.
SPREADSHEET_ID=your_spreadsheet_id
